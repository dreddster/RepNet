[0.005418, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.005793, "o", "RepNet lifecycle demo — staged product flow with real DKG feedback writes/queries\r\nContractor: 0x0785EfF59f6867Ef196Bb60da1d934A847C3D3Be\r\nWorker:     0x4DCF8773e04505fEAf9558D0BB248Efc06d5ab64\r\nMock LLM review text is labeled. Reputation upload/query output is real DKG output.\r\n"]
[4.007909, "o", "\u001b[H\u001b[2J\u001b[3J"]
[4.008115, "o", "\r\n\r\n  NEXT\r\n  Contractor — Posts a new job\r\n\r\n  CG 15 · repnet-official · synthetic demo identities\r\n\r\n"]
[6.410585, "o", "\r\n$ repnet job-board create --public \"Build API monitoring dashboard\" --budget 500 USDC\r\n{\r\n  \"jobId\": \"repnet-job:demo-1778693165-live-review\",\r\n  \"status\": \"open\",\r\n  \"publicSpec\": \"API monitoring dashboard\",\r\n  \"privateSpecHash\": \"0xprivate-spec-hash-hidden\"\r\n}\r\n"]
[9.418991, "o", "\u001b[H\u001b[2J\u001b[3J"]
[9.419593, "o", "\r\n\r\n  NEXT\r\n  Worker — Finds the job, checks Contractor reputation, applies\r\n\r\n  CG 15 · repnet-official · synthetic demo identities\r\n\r\n"]
[11.824104, "o", "\r\n$ repnet dkg query-feedback --identity contractor --limit 5\r\n"]
[12.575227, "o", "{\r\n  \"source\": \"DKG query\",\r\n  \"role\": \"contractor\",\r\n  \"events\": [\r\n    {\r\n      \"event\": \"urn:repnet:job-reputation-event:demo-1778693165:contractor-prior:1\",\r\n      \"jobId\": \"demo-1778693165-contractor-prior-1\",\r\n      \"subjectRole\": \"contractor\",\r\n      \"terminalPath\": \"released\",\r\n      \"summary\": \"Clear scope and fast review cycle.\",\r\n      \"kind\": \"prior\"\r\n    },\r\n    {\r\n      \"event\": \"urn:repnet:job-reputation-event:demo-1778693165:contractor-prior:2\",\r\n      \"jobId\": \"demo-1778693165-contractor-prior-2\",\r\n      \"subjectRole\": \"contractor\",\r\n      \"terminalPath\": \"released\",\r\n      \"summary\": \"Requested one amendment with useful detail.\",\r\n      \"kind\": \"prior\"\r\n    },\r\n    {\r\n      \"event\": \"urn:repnet:job-reputation-event:demo-1778693165:contractor-prior:3\",\r\n      \"jobId\": \"demo-1778693165-contractor-prior-3\",\r\n      \"subjectRole\": \"contractor\",\r\n      \"terminalPath\": \"released\",\r\n      \"summary\": \"Funded promptly and gave actionable acceptance criteria.\",\r\n      \"kind\": \"prior\"\r\n    },\r\n    {\r\n      \"event\": \"urn:repnet:job-reputation-event:demo-1778693165:contractor-prior:4\",\r\n      \"jobId\": \"demo-1778693165-contractor-prior-4\",\r\n      \"subjectRole\": \"contractor\",\r\n      \"terminalPath\": \"released\",\r\n      \"summary\": \"Scope changed once; final acceptance was fair.\",\r\n      \"kind\": \"prior\"\r\n    },\r\n    {\r\n      \"event\": \"urn:repnet:job-reputation-event:demo-1778693165:contractor-prior:5\",\r\n      \"jobId\": \"demo-1778693165-contractor-prior-5\",\r\n      \"subjectRole\": \"contractor\",\r\n      \"terminalPath\": \"released\",\r\n      \"summary\": \"Excellent async communication and payment release.\",\r\n      \"kind\": \"prior\"\r\n    }\r\n  ]\r\n}\r\n"]
[18.582467, "o", "\r\n$ repnet job-board apply --job repnet-job --proposal-hash 0xproposal-hidden\r\n{\r\n  \"applicationStatus\": \"submitted\",\r\n  \"privateProposalVisible\": false\r\n}\r\n"]
[21.586978, "o", "\u001b[H\u001b[2J\u001b[3J"]
[21.587124, "o", "\r\n\r\n  NEXT\r\n  Contractor — Sees application, checks Worker reputation, selects Worker\r\n\r\n  CG 15 · repnet-official · synthetic demo identities\r\n\r\n"]
